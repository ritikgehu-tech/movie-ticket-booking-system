class Seat {
public:
    enum class Type {
        SILVER,
        GOLD,
        PLATINUM
    };

private:
    int number;
    Type type;

public:
    Seat(int number, Type type)
        : number(number), type(type) {}

    int getNumber() const {
        return number;
    }

    Type getType() const {
        return type;
    }

    string getTypeName() const {
        if (type == Type::SILVER)
            return "SILVER";

        if (type == Type::GOLD)
            return "GOLD";

        return "PLATINUM";
    }
};
