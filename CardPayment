// Inheritance + Runtime Polymorphism

class CardPayment : public Payment {
private:
    string cardNumber;

public:
    CardPayment(string cardNumber)
        : cardNumber(cardNumber) {}

    bool pay(double amount) override {

        if (cardNumber.size() < 4) {
            cout << "Invalid card details.\n";
            return false;
        }

        cout << "\nProcessing Card payment of Rs."
             << fixed << setprecision(2)
             << amount << "...\n";

        cout << "Card payment successful.\n";

        return true;
    }

    string methodName() const override {
        return "CARD";
    }
};
